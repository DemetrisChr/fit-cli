// Runs the Operational Insights SDK performers (the `insights-*` entries in
// src/util/sdk/sdks.ts) against a self-managed Operational Insights cluster.
// Operational Insights is the renamed Enterprise Analytics, so the cluster is built
// exactly as in the enterprise-analytics-func-* presets — cbdinocluster picks the
// operational-insights image for any 3.x+ version.
//
// Cross-testing needs no extra preset, as any Analytics performer runs any analytics
// preset:
//   EA SDK against OI:  fit run preset insights-func-lite --performer analytics-java-fit-performer:main
//   OI SDK against EA:  fit run preset insights-func-lite --performer insights-python-fit-performer:main \
//                         --env-override defaults.operationalInsightsVersion=2.2.0-1166
//   (or simply: fit run preset enterprise-analytics-func-lite --performer insights-python-fit-performer:main)
//
// Only one build/topology is currently supported, so this is identical to
// insights-func-release — kept separate for naming consistency across axes.
{
  preset: {
    order: 20,
    tags: ['insights', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'analytics-functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          // cbdino wire flag: `columnar: true` builds a self-managed Enterprise
          // Analytics cluster; the docker deployer fronts it with an nginx load balancer.
          columnar: true,
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.operationalInsightsVersion}}',
            },
          ],
          docker: {
            'passive-load-balancer': true,
            'use-dino-certs': true,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          // The driver connects classically for admin (filled in by fit-cli); the
          // SDK/performer reaches Analytics through the load balancer's query port.
          clusterParams: {
            loadBalancedCluster: {
              ports: [8095, 18095],
            },
          },
          performer: {
            connectionString: 'http://${defaultHostname}:8095',
            tls: null,
          },
        },
      },
    },
  ],
}
